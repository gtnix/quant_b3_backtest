# Strategy Factory Environment Variables Template
# =============================================================================
#
# Copy these exports to your shell profile (~/.bashrc or ~/.zshrc) or create
# a local .env file and source it before running factory commands.
#
# Usage:
#   source configs/factory_env.template
#   ./target/release/combiner factory list
#
# Or add to ~/.bashrc:
#   export NEON_DATABASE_URL="postgresql://..."
#
# =============================================================================

# NEON POSTGRES DATABASE
# Connection string for Strategy Factory registry
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
export NEON_DATABASE_URL="postgresql://your_user:your_password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# RUST CONFIGURATION
export RUST_BACKTRACE=1
export RUST_LOG=info

# FACTORY CONFIGURATION
export FACTORY_JSON_LOGS=1
export RAYON_NUM_THREADS=8

echo "Factory environment configured. NEON_DATABASE_URL is set."
















