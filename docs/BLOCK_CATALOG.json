{
  "selection": [
    {
      "block_id": "size",
      "description": "Size selection: filters by market cap (small/mid/large)",
      "default_params": {
        "top_pct": 20.0
      }
    },
    {
      "block_id": "dividend",
      "description": "Dividend yield selection: high dividend stocks",
      "default_params": {
        "top_pct": 20.0
      }
    },
    {
      "block_id": "quality",
      "description": "Quality selection: high ROE, low debt companies",
      "default_params": {
        "top_pct": 20.0
      }
    },
    {
      "block_id": "momentum",
      "description": "Momentum selection: ranks assets by 6-12 month returns",
      "default_params": {
        "top_pct": 20.0
      }
    },
    {
      "block_id": "low_vol",
      "description": "Low volatility selection: selects stable, low-vol assets",
      "default_params": {
        "top_pct": 20.0
      }
    },
    {
      "block_id": "value",
      "description": "Value selection: selects low P/E, low P/B stocks",
      "default_params": {
        "top_pct": 20.0
      }
    },
    {
      "block_id": "carry",
      "description": "Carry selection: dividend yield vs risk-free rate",
      "default_params": {
        "top_pct": 20.0
      }
    }
  ],
  "exit": [
    {
      "block_id": "take_profit",
      "description": "Take-profit: Exit on gain exceeding target",
      "default_params": {
        "target_pct": 0.3
      }
    },
    {
      "block_id": "trailing_stop",
      "description": "Trailing stop: Exit on drawdown from high-water mark",
      "default_params": {
        "trailing_pct": 0.15,
        "activation_pct": 0.1
      }
    },
    {
      "block_id": "time_exit",
      "description": "Time exit: Exit after holding for max days",
      "default_params": {
        "max_days": 20
      }
    },
    {
      "block_id": "stop_loss",
      "description": "Stop-loss: Exit on loss exceeding threshold",
      "default_params": {
        "threshold_pct": 0.1
      }
    }
  ],
  "sizing": [
    {
      "block_id": "equal_weight",
      "description": "Equal weight: 1/N allocation across selected assets",
      "default_params": {
        "min_weight": 0.02,
        "max_weight": 0.2,
        "max_positions": 20
      }
    },
    {
      "block_id": "risk_parity",
      "description": "Risk parity: Inverse volatility weighting",
      "default_params": {
        "min_weight": 0.02,
        "max_positions": 20,
        "fallback_vol": 0.25,
        "max_weight": 0.2
      }
    },
    {
      "block_id": "vol_targeting",
      "description": "Vol targeting: Scale positions to achieve target portfolio volatility",
      "default_params": {
        "max_weight": 0.3,
        "min_weight": 0.02,
        "target_vol": 0.12,
        "max_leverage": 1.0,
        "correlation": 0.5,
        "fallback_vol": 0.25,
        "max_positions": 20
      }
    }
  ],
  "entry": [
    {
      "block_id": "macd",
      "description": "MACD: Long on bullish crossover, exit on bearish crossover",
      "default_params": {
        "signal": 9,
        "fast_ema": 12,
        "slow_ema": 26
      }
    },
    {
      "block_id": "rsi",
      "description": "RSI: Long on oversold (<30), exit on overbought (>70)",
      "default_params": {
        "oversold": 30.0,
        "period": 14,
        "overbought": 70.0
      }
    },
    {
      "block_id": "bollinger",
      "description": "Bollinger Bands: Signal on breakouts above/below bands",
      "default_params": {
        "period": 20,
        "std_dev": 2.0
      }
    },
    {
      "block_id": "ma_crossover",
      "description": "MA Crossover: Long when fast MA crosses above slow MA",
      "default_params": {
        "fast_period": 50,
        "slow_period": 200
      }
    },
    {
      "block_id": "zscore",
      "description": "Z-Score: Long on z < -2 (oversold), exit on z > 2 (overbought)",
      "default_params": {
        "threshold": 2.0,
        "period": 20
      }
    }
  ]
}