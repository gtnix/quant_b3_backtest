graph TD
    A[Backtest Result] --> B["1. SERIALIZATION (rkyv)"];
    B --> C["2. COMPRESSION"];
    C --> D["3. WRITE-AHEAD LOG (walrus-rust)"];
    D --> E["4. STORAGE ENGINE (Fjall LSM-tree)"];
    E --> F["5. INTEGRITY SEAL"];

    subgraph B_sub [Serialization]
        B1["Serialize to zero-copy format"]
        B2["Compute XXH3 checksum (59.4 GB/s)"]
    end

    subgraph C_sub [Compression]
        C1["Metadata: Zstd"]
        C2["Metrics: Zstd"]
        C3["Time-Series: tms/tsink"]
        C4["Trace: Zstd"]
    end

    subgraph D_sub [Write-Ahead Log]
        D1["Append to WAL (1M ops/sec, 1 GB/s)"]
        D2["Atomic durability guarantee"]
    end

    subgraph E_sub [Storage Engine]
        E1["Write to memtable"]
        E2["Background flush to SST files"]
        E3["Tiered compaction"]
    end

    subgraph F_sub [Integrity Seal]
        F1["Compute BLAKE3 hash (4.4 GB/s)"]
        F2["Store hash in metadata"]
        F3["Immutable artifact created"]
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
