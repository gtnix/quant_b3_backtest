graph TD
    A["Query Request (UUID or Filter)"] --> B["1. METADATA LOOKUP (LMDB via heed)"];
    B --> C["2. MEMORY MAPPING (memmap2)"];
    C --> D["3. INTEGRITY VALIDATION (XXH3)"];
    D --> E["4. DECOMPRESSION (Seekable)"];
    E --> F["5. ZERO-COPY DESERIALIZATION (rkyv)"];

    subgraph B_sub [Metadata Lookup]
        B1["Zero-copy read (47ms for 16-thread random reads)"]
        B2["Retrieve artifact location and hash"]
    end

    subgraph C_sub [Memory Mapping]
        C1["mmap compressed file"]
        C2["OS page cache optimization"]
    end

    subgraph D_sub [Integrity Validation]
        D1["Compute checksum (59.4 GB/s)"]
        D2["Compare with stored hash"]
        D3["Fail fast on corruption"]
    end

    subgraph E_sub [Decompression]
        E1["Zstd Seekable (zeekstd): 1.43 GiB/s"]
        E2["Decompress only required frames"]
        E3["Time-Series: tms/tsink (SIMD-optimized)"]
    end

    subgraph F_sub [Zero-Copy Deserialization]
        F1["Direct access to data (1.36 ns)"]
        F2["No memcpy or allocation"]
        F3["Return borrowed references"]
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style B fill:#ccf,stroke:#333,stroke-width:2px
    style C fill:#ccf,stroke:#333,stroke-width:2px
    style D fill:#ccf,stroke:#333,stroke-width:2px
    style E fill:#ccf,stroke:#333,stroke-width:2px
    style F fill:#ccf,stroke:#333,stroke-width:2px
