graph TD
    A["artifacts/"] --> B["metadata.lmdb"];
    A --> C["wal/"];
    A --> D["data/"];
    A --> E["integrity/"];

    subgraph B_sub [LMDB Database]
        B1["uuid -> artifact_location"]
        B2["uuid -> blake3_hash"]
        B3["uuid -> metrics.json"]
    end

    subgraph C_sub [Write-Ahead Log]
        C1["segment_0000.wal"]
        C2["segment_0001.wal"]
    end

    subgraph D_sub [Data Blocks]
        D1["data_0000.obfs"]
        D2["timeseries_0000.parquet"]
    end

    subgraph E_sub [Integrity Manifest]
        E1["manifest.blake3"]
    end

    style A fill:#f9f,stroke:#333,stroke-width:2px
    style B fill:#ccf,stroke:#333,stroke-width:2px
    style C fill:#ccf,stroke:#333,stroke-width:2px
    style D fill:#ccf,stroke:#333,stroke-width:2px
    style E fill:#ccf,stroke:#333,stroke-width:2px
