# Alpha Forge - VPS Credentials Template
# Copy to .env.vps and fill in your values
# DO NOT COMMIT .env.vps!

# Vultr VPS
VPS_IP=your-vps-ip
VPS_USER=root
VPS_PASS='your-vps-password'

# Vultr API (https://my.vultr.com/settings/#settingsapi)
VULTR_API_KEY=your-vultr-api-key

# Dashboard Auth (will be generated during setup)
DASHBOARD_USER=admin
DASHBOARD_PASS=will-be-generated
