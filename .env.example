# =============================================================================
# Quant B3 Backtest - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials

# =============================================================================
# Required
# =============================================================================

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Brapi API key for Brazilian market data (B3)
# Get yours at: https://brapi.dev/
BRAPI_API_KEY=your_brapi_api_key_here

# =============================================================================
# Optional (have defaults or only needed for specific features)
# =============================================================================

# Alternative US data source (optional, yfinance is default)
# ALPHAVANTAGE_API_KEY=your_alphavantage_key

# FRED API for FX historical data (optional)
# FRED_API_KEY=your_fred_api_key

# Rust debugging (optional)
# RUST_BACKTRACE=1
# RUST_LOG=info

# Custom binary paths (optional, defaults to target/release/)
# BACKTEST_CLI_PATH=target/release/backtest
# COMBINER_PATH=target/release/combiner
